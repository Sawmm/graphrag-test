# ──────────────────────────────────────────────────────────────────────────────
#  FAMILY 6 — §10(6): Non-training systems
#  Tractability: ✅ Full (structural conditional via SPARQL)
#
#  For systems NOT using training techniques, §§10(2)-(5) apply ONLY to
#  testing data. This shape warns if a non-training system has linked
#  training or validation datasets (likely modelling error).
# ──────────────────────────────────────────────────────────────────────────────

gai-act:NonTrainingSystemShape a sh:NodeShape ;
    sh:targetClass gai-act:HighRiskAISystem ;
    sh:severity sh:Warning ;
    sh:sparql [
        sh:message "Art. 10(6): System is declared non-training but has training/validation datasets linked — verify modelling."@en ;
        sh:prefixes [
            sh:declare [
                sh:prefix "gai-act" ;
                sh:namespace "https://gelsi.com/gai-act#"^^xsd:anyURI ;
            ] ;
        ] ;
        sh:select """
            SELECT $this WHERE {
                $this gai-act:usesTrainingTechniques false .
                { $this gai-act:hasTrainingDataset ?d }
                UNION
                { $this gai-act:hasValidationDataset ?d }
            }
        """ ;
    ] .

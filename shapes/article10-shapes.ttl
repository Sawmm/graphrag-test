@prefix sh:      <http://www.w3.org/ns/shacl#> .
@prefix gai-act: <https://gelsi.com/gai-act#> .
@prefix dcat:    <http://www.w3.org/ns/dcat#> .
@prefix dct:     <http://purl.org/dc/terms/> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix tair:    <http://tair.adaptcentre.ie/ontologies/tair/> .

# ══════════════════════════════════════════════════════════════════════════════
#  SHACL shapes — EU AI Act Article 10 (Data Governance)
#
#  Shape families:
#    Family 1  §10(1)  — Dataset existence (3 shapes)
#    Family 2  §10(2)  — Data governance documentation (8 sub-shapes, reusable)
#    Family 3  §10(3)  — Dataset quality documentation (4 shapes)
#    Family 4  §10(4)  — Contextual characteristics documentation (1 shape)
#    Family 5  §10(5)  — Sensitive data conditional (SPARQL, 6 sub-shapes)
#    Family 6  §10(6)  — Non-training systems conditional (SPARQL)
#
#  Documentation Proxy Principle: "Partial" obligations (marked ⚠️) are
#  checked by verifying existence of a gai-act:DocumentationNode, not the
#  adequacy of its content. This reflects Art. 10's audit-oriented nature.
# ══════════════════════════════════════════════════════════════════════════════


# ──────────────────────────────────────────────────────────────────────────────
#  FAMILY 1 — §10(1): Dataset existence
#  Tractability: ✅ Full (structural check)
# ──────────────────────────────────────────────────────────────────────────────

gai-act:TrainingDataExistenceShape a sh:NodeShape ;
    sh:targetClass gai-act:HighRiskAISystem ;
    sh:severity sh:Violation ;
    sh:property [
        sh:path gai-act:hasTrainingDataset ;
        sh:minCount 1 ;
        sh:class dcat:Dataset ;
        sh:message "Art. 10(1): High-risk AI system must have a training dataset."@en ;
    ] .

gai-act:ValidationDataExistenceShape a sh:NodeShape ;
    sh:targetClass gai-act:HighRiskAISystem ;
    sh:severity sh:Violation ;
    sh:property [
        sh:path gai-act:hasValidationDataset ;
        sh:minCount 1 ;
        sh:class dcat:Dataset ;
        sh:message "Art. 10(1): High-risk AI system must have a validation dataset."@en ;
    ] .

gai-act:TestingDataExistenceShape a sh:NodeShape ;
    sh:targetClass gai-act:HighRiskAISystem ;
    sh:severity sh:Violation ;
    sh:property [
        sh:path gai-act:hasTestingDataset ;
        sh:minCount 1 ;
        sh:class dcat:Dataset ;
        sh:message "Art. 10(1): High-risk AI system must have a testing dataset."@en ;
    ] .


# ──────────────────────────────────────────────────────────────────────────────
#  FAMILY 2 — §10(2): Data governance documentation
#  Tractability: ⚠️ Partial (documentation proxy — existence check only)
#
#  DatasetGovernanceShape is reusable: applied via sh:node from the three
#  per-dataset-type shapes below, avoiding duplication of the 8 sub-checks.
# ──────────────────────────────────────────────────────────────────────────────

# Reusable shape: checks §10(2a–h) on any dcat:Dataset node
gai-act:DatasetGovernanceShape a sh:NodeShape ;
    sh:severity sh:Violation ;
    sh:property [
        sh:path gai-act:hasDesignChoicesDoc ;
        sh:minCount 1 ;
        sh:class gai-act:DocumentationNode ;
        sh:message "Art. 10(2a): Dataset must have documented design choices."@en ;
    ] ;
    sh:property [
        sh:path gai-act:hasProvenanceDoc ;
        sh:minCount 1 ;
        sh:class gai-act:DocumentationNode ;
        sh:message "Art. 10(2b): Dataset must have documented data collection processes and origin."@en ;
    ] ;
    sh:property [
        sh:path gai-act:hasPreprocessingDoc ;
        sh:minCount 1 ;
        sh:class gai-act:DocumentationNode ;
        sh:message "Art. 10(2c): Dataset must have documented data-preparation operations."@en ;
    ] ;
    sh:property [
        sh:path gai-act:hasAssumptionsDoc ;
        sh:minCount 1 ;
        sh:class gai-act:DocumentationNode ;
        sh:message "Art. 10(2d): Dataset must have documented assumptions about what the data measures."@en ;
    ] ;
    sh:property [
        sh:path gai-act:hasSuitabilityDoc ;
        sh:minCount 1 ;
        sh:class gai-act:DocumentationNode ;
        sh:message "Art. 10(2e): Dataset must have a documented suitability assessment."@en ;
    ] ;
    sh:property [
        sh:path gai-act:hasBiasExaminationDoc ;
        sh:minCount 1 ;
        sh:class gai-act:DocumentationNode ;
        sh:message "Art. 10(2f): Dataset must have documented bias examination."@en ;
    ] ;
    sh:property [
        sh:path gai-act:hasBiasMitigationDoc ;
        sh:minCount 1 ;
        sh:class gai-act:DocumentationNode ;
        sh:message "Art. 10(2g): Dataset must have documented bias mitigation measures."@en ;
    ] ;
    sh:property [
        sh:path gai-act:hasDataGapDoc ;
        sh:minCount 1 ;
        sh:class gai-act:DocumentationNode ;
        sh:message "Art. 10(2h): Dataset must have documented data gaps and shortcomings."@en ;
    ] .

# Applied to each dataset type via sh:node
gai-act:TrainingDataGovernanceShape a sh:NodeShape ;
    sh:targetClass gai-act:HighRiskAISystem ;
    sh:severity sh:Violation ;
    sh:property [
        sh:path gai-act:hasTrainingDataset ;
        sh:minCount 1 ;
        sh:node gai-act:DatasetGovernanceShape ;
        sh:message "Art. 10(2): Training dataset must satisfy all data governance documentation requirements."@en ;
    ] .

gai-act:ValidationDataGovernanceShape a sh:NodeShape ;
    sh:targetClass gai-act:HighRiskAISystem ;
    sh:severity sh:Violation ;
    sh:property [
        sh:path gai-act:hasValidationDataset ;
        sh:minCount 1 ;
        sh:node gai-act:DatasetGovernanceShape ;
        sh:message "Art. 10(2): Validation dataset must satisfy all data governance documentation requirements."@en ;
    ] .

gai-act:TestingDataGovernanceShape a sh:NodeShape ;
    sh:targetClass gai-act:HighRiskAISystem ;
    sh:severity sh:Violation ;
    sh:property [
        sh:path gai-act:hasTestingDataset ;
        sh:minCount 1 ;
        sh:node gai-act:DatasetGovernanceShape ;
        sh:message "Art. 10(2): Testing dataset must satisfy all data governance documentation requirements."@en ;
    ] .


# ──────────────────────────────────────────────────────────────────────────────
#  FAMILY 3 — §10(3): Dataset quality documentation
#  Tractability: ⚠️ Partial (documentation proxy — "free of errors" not
#  machine-checkable; verified by existence of quality metrics documentation)
# ──────────────────────────────────────────────────────────────────────────────

gai-act:DatasetQualityShape a sh:NodeShape ;
    sh:severity sh:Violation ;
    sh:property [
        sh:path gai-act:hasRelevanceDoc ;
        sh:minCount 1 ;
        sh:class gai-act:DocumentationNode ;
        sh:message "Art. 10(3): Dataset must have documented relevance to the intended purpose."@en ;
    ] ;
    sh:property [
        sh:path gai-act:hasRepresentativenessDoc ;
        sh:minCount 1 ;
        sh:class gai-act:DocumentationNode ;
        sh:message "Art. 10(3): Dataset must have documented representativeness."@en ;
    ] ;
    sh:property [
        sh:path gai-act:hasStatisticalPropsDoc ;
        sh:minCount 1 ;
        sh:class gai-act:DocumentationNode ;
        sh:message "Art. 10(3): Dataset must have documented statistical properties."@en ;
    ] ;
    sh:property [
        sh:path gai-act:hasQualityMetricsDoc ;
        sh:minCount 1 ;
        sh:class gai-act:DocumentationNode ;
        sh:message "Art. 10(3): Dataset must have documented quality metrics (proxy for 'free of errors and complete')."@en ;
    ] .

gai-act:TrainingDataQualityShape a sh:NodeShape ;
    sh:targetClass gai-act:HighRiskAISystem ;
    sh:severity sh:Violation ;
    sh:property [
        sh:path gai-act:hasTrainingDataset ;
        sh:minCount 1 ;
        sh:node gai-act:DatasetQualityShape ;
        sh:message "Art. 10(3): Training dataset must satisfy quality documentation requirements."@en ;
    ] .

gai-act:ValidationDataQualityShape a sh:NodeShape ;
    sh:targetClass gai-act:HighRiskAISystem ;
    sh:severity sh:Violation ;
    sh:property [
        sh:path gai-act:hasValidationDataset ;
        sh:minCount 1 ;
        sh:node gai-act:DatasetQualityShape ;
        sh:message "Art. 10(3): Validation dataset must satisfy quality documentation requirements."@en ;
    ] .

gai-act:TestingDataQualityShape a sh:NodeShape ;
    sh:targetClass gai-act:HighRiskAISystem ;
    sh:severity sh:Violation ;
    sh:property [
        sh:path gai-act:hasTestingDataset ;
        sh:minCount 1 ;
        sh:node gai-act:DatasetQualityShape ;
        sh:message "Art. 10(3): Testing dataset must satisfy quality documentation requirements."@en ;
    ] .



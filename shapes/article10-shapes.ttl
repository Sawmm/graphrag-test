# ──────────────────────────────────────────────────────────────────────────────
#  FAMILY 5 — §10(5): Sensitive data processing conditional
#  Tractability: ⚠️ Partial (SHACL-SPARQL conditional + documentation proxies)
#
#  Trigger: gai-act:processesSensitiveDataForBias = true
#  If triggered: all 6 sub-conditions (5a–5f) must be documented.
# ──────────────────────────────────────────────────────────────────────────────

gai-act:SensitiveDataNecessityShape a sh:NodeShape ;
    sh:targetClass gai-act:HighRiskAISystem ;
    sh:severity sh:Violation ;
    sh:sparql [
        sh:message "Art. 10(5a): System processes sensitive data but lacks necessity justification (why other data insufficient)."@en ;
        sh:prefixes [
            sh:declare [
                sh:prefix "gai-act" ;
                sh:namespace "https://gelsi.com/gai-act#"^^xsd:anyURI ;
            ] ;
        ] ;
        sh:select """
            SELECT $this WHERE {
                $this gai-act:processesSensitiveDataForBias true .
                FILTER NOT EXISTS { $this gai-act:hasSensitiveDataNecessityDoc ?doc }
            }
        """ ;
    ] .

gai-act:SensitiveDataSecurityShape a sh:NodeShape ;
    sh:targetClass gai-act:HighRiskAISystem ;
    sh:severity sh:Violation ;
    sh:sparql [
        sh:message "Art. 10(5b): System processes sensitive data but lacks security and pseudonymisation documentation."@en ;
        sh:prefixes [
            sh:declare [
                sh:prefix "gai-act" ;
                sh:namespace "https://gelsi.com/gai-act#"^^xsd:anyURI ;
            ] ;
        ] ;
        sh:select """
            SELECT $this WHERE {
                $this gai-act:processesSensitiveDataForBias true .
                FILTER NOT EXISTS { $this gai-act:hasSensitiveDataSecurityDoc ?doc }
            }
        """ ;
    ] .

